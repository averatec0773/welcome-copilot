# Copy the relevant values into web/.env.local for local development.
# Production values live in Vercel -> Settings -> Environment Variables.

ANTHROPIC_API_KEY=       # console.anthropic.com -> API Keys (assistant)
SHEET_ID=                # Google Sheet id (between /d/ and /edit in its URL)
GOOGLE_SA_KEY_PATH=      # local path to the service-account JSON (never commit it)
# GOOGLE_SA_KEY_B64=     # deploys: base64 of that JSON instead of a path
UPSTASH_REDIS_REST_URL=  # Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_TOKEN=
HEALTHCHECKS_BADGE_URL=  # public status badge shown on the health view
DEMO_ACCESS_CODE=        # invite code for free-form questions; 12+ random characters
